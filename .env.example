# Copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) — or the legacy "anon public" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SERVER ONLY — the "secret" key (sb_secret_...) or legacy "service_role" key.
# Used to create staff accounts. Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=your-secret-key
